# Copy this file to ".env" and fill in ONE of the keys below.
# NEVER commit your real .env file.

# Which model backend to use: auto | gemini | openai | fallback
#   auto     = use whichever key is present, else the rule-based fallback
#   fallback = force the clearly-labelled rule-based agents (works offline)
ARES_LLM_PROVIDER=auto

# Google Gemini (recommended free tier)
GEMINI_API_KEY=
# Some deployments expose the key under this name instead:
GOOGLE_API_KEY=
# Gemini model to use. Default (low-cost, verified working) is
# gemini-3.5-flash-lite. To evaluate another model set it here, e.g.
#   GEMINI_MODEL=gemini-flash-lite-latest
# To revert simply remove/blank the line -> falls back to the default.
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
ARES_LLM_TEMPERATURE=0.4
ARES_LLM_TIMEOUT=45
ARES_MAX_ROUNDS=8
